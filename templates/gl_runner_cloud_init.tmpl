#!/usr/bin/env bash

hostname ${hostname}

cat << EOF > /tmp/gitlab-runner.template.toml
concurrent = ${runner_concurrency}

[[runners]]
EOF

/usr/bin/gitlab-runner register \
--non-interactive \
--template-config /tmp/gitlab-runner.template.toml \
--url 'https://${gitlab_host}/' \
--registration-token '${registration_token}' \
--executor docker --docker-image ${docker_image} \
--locked=${locked} --tag-list ${runner_tags} --run-untagged=${run_untagged}
