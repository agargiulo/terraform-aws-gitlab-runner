#!/usr/bin/env bash

# "Expressions don't expand in single quotes" - yes but they are expanded before bash runs
# shellcheck disable=SC2016
function cloud_init() {
  runner_name=$(aws ec2 describe-instances --instance-ids "$(cloud-init query instance_id)" --query 'Reservations[0].Instances[0].Tags[? Key == `Name`].Value' --region=us-west-2 --output text)


  /usr/bin/gitlab-runner register \
  --non-interactive \
  --url 'https://${gitlab_host}/' \
  --registration-token '${registration_token}' \
  --executor docker --docker-image '${docker_image}' \
  --locked='${locked}' --tag-list '${runner_tags}' --run-untagged='${run_untagged}' \
  --cache-type s3 --cache-path '${s3_cache_config["prefix"]}' --cache-shared='${s3_cache_config["shared"]}'\
  --cache-s3-server-address "s3.amazonaws.com" \
  --cache-s3-bucket-name '${s3_cache_config["bucket"]}' \
  --cache-s3-bucket-location '${s3_cache_config["region"]}' \
  --cache-s3-insecure=false \
  --name "$runner_name"

  # I tried. I tried to use a template and that wasn't working right. So on to this way I guess.
  sed -i'' 's/concurrent = 1/concurrent = ${runner_concurrency}/' /etc/gitlab-runner/config.toml

  systemctl restart gitlab-runner
  # I'm sure I can add this to the AMI build, but that's slow.
  # At least this way, if there's an issue, fixing it is easier.
  # Once this is working for sure, I'll bake it into the AMI. ~agargiulo
  cat << UNREGISTER_EOF > /tmp/unregister_runners.sh
#!/usr/bin/env bash
if [[ "\$1" != "reboot" ]]; then
  gitlab-runner unregister --all-runners
fi
UNREGISTER_EOF

  # https://www.freedesktop.org/software/systemd/man/systemd-halt.service.html
  install -p -m 0755 /tmp/unregister_runners.sh /usr/lib/systemd/system-shutdown/unregister_runners.sh
}

cloud_init 1>/var/log/cloud-init-user.log 2>/var/log/cloud-init-user-error.log
